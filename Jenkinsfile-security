def version = "10.0"
def slackResponse = null

def errors = []

def changeUrl = env.CHANGE_URL

// Check vulns in dependencies on repo branches
def failedBuild = false

pipeline {
    agent none

    environment {
        CI = 1
    }
    triggers { cron('@daily') }

    stages {
        stage('deps') {
            when { not { changeRequest() } }
            agent {
                dockerfile {
                    label 'generic-docker'
                    filename 'webapp/sources/Dockerfile'
                    // and share maven cache
                    args '-u 0:0 -v /srv/cache/maven:/root/.m2'
                }
            }
            environment {
                TRIVY_DISABLE_VEX_NOTICE = '1'
            }
            steps {
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            dir('webapp/sources/') {
                                sh script: 'mvn --batch-mode --update-snapshots -Djansi.passthrough=true -Dstyle.color=always dependency:resolve', label: "load webapp dependencies"
                            }
                            dir('webapp/sources/rudder/rudder-web/src/main/') {
                                sh script: "npm_config_loglevel=error npm ci --no-audit", label: "load npm dependencies"
                            }
                            sh script: "trivy fs --skip-version-check --no-progress .", label: "scanning dependencies for vulnerabilities"
                    }
                }
            }
            post {
                failure {
                    script {
                        slackResponse = notifyError(errors, slackResponse, version, changeUrl, "deps", "Dependency check error")
                    }
                }
                cleanup {
                    script {
                        cleanWs(deleteDirs: true, notFailBuild: true)
                    }
                }
            }
        }
        stage('deps-rust-pr') {
            when { changeRequest() }
            agent {
                dockerfile {
                    label 'generic-docker'
                    filename 'relay/sources/relayd/Dockerfile'
                    // mount cache
                    args '-u 0:0 -v /srv/cache/cargo:/usr/local/cargo/registry'
                }
            }
            steps {
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                        sh script: 'mkdir -p target', label: 'create target directory'
                        sh script: 'cargo deny check licenses sources bans', label: 'check rust dependencies'
                    }
                }
            }
            post {
                failure {
                    script {
                        // Will not send a slack message, but wwe use it to keep it like other stages
                        slackResponse = notifyError(errors, slackResponse, version, changeUrl, "deps-rust-pr", "Dependency check error")
                    }
                }
                cleanup {
                    script {
                        cleanWs(deleteDirs: true, notFailBuild: true)
                    }
                }
            }

        }
    }
    post {
        always {
            script {
                // all stages catch their errors with buildResult: 'SUCCESS',
                // so a non-SUCCESS result here means something escaped them (agent failure, abort, ...)
                if (currentBuild.currentResult != 'SUCCESS') {
                    errors.add("Build ended unexpectedly (${currentBuild.currentResult})")
                    failedBuild = true
                }
                slackResponse = updateSlack(errors, slackResponse, version, changeUrl, true)
                if (failedBuild) {
                    currentBuild.result = 'FAILURE'
                }
            }
        }
    }
}



def notifyError(errors, slackResponse, version, changeUrl, stageName, slackMessage) {
    failedBuild = true
    errors.add(stageName)
    if (changeUrl == null) {
      slackResponse = updateSlack(errors, slackResponse, version, changeUrl, false)
      slackSend(channel: slackResponse.threadId, message: "${slackMessage} - <${currentBuild.absoluteUrl}|Link>", color: "#CC3421")
    }
    return slackResponse

}

def updateSlack(errors, slackResponse, version, changeUrl, isEnded) {
  def msg ="*${version} - rudder dependency check* - <"+currentBuild.absoluteUrl+"|Link>"

  if (changeUrl == null) {

      // previousBuild is null on the first build of a branch
      def fixed = currentBuild.resultIsBetterOrEqualTo("SUCCESS") && currentBuild.previousBuild != null && currentBuild.previousBuild.resultIsWorseOrEqualTo("UNSTABLE")
      if (errors.isEmpty() && isEnded && fixed) {
        msg +=  " => No security issues found! :white_check_mark:"
        def color = "good"
        slackSend(channel: "ci-security", message: msg, color: color)
      }


      if (! errors.isEmpty()) {
          msg += "\n*Errors* :x: ("+errors.size()+")\n  • " + errors.join("\n  • ")
          def color = "#CC3421"
          if (slackResponse == null) {
            slackResponse = slackSend(channel: "ci-security", message: msg, color: color)
          }
          slackSend(channel: slackResponse.channelId, message: msg, timestamp: slackResponse.ts, color: color)
      }
      return slackResponse
  }
}
